<?xml version="1.2"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>executor_manager</name>
  <version>0.0.1</version>
  <description>Action client for tasks execution</description>
  <maintainer email="marco.soriano5102@comunidad.unam.mx">Marco Soriano</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- C++ / Build -->
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  
  <!-- ROS -->
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>

  <!-- Interfaces -->
  <depend>executor_interfaces</depend>
  <depend>supervisor_executor_interfaces</depend>

  <!-- Test -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
